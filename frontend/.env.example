# Backend API Configuration
REACT_APP_BACKEND_URL=http://192.168.1.243:5000
REACT_APP_WS_URL=ws://192.168.1.243:5000/ws

# AI Server Configuration (for direct calls if needed)
REACT_APP_AI_SERVER_URL=http://192.168.1.x:8000

# Display Configuration
REACT_APP_CLOCK_FORMAT=24hr
REACT_APP_SHOW_SECONDS=true
REACT_APP_AUTO_DIM=true
REACT_APP_DIM_START_HOUR=22
REACT_APP_DIM_END_HOUR=7

# Feature Flags
REACT_APP_ENABLE_VOICE=true
REACT_APP_ENABLE_FACE_RECOGNITION=true
REACT_APP_ENABLE_MEDIA_PLAYER=true
REACT_APP_ENABLE_CAMERA=true

# Debug
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=info
