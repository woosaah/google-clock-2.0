# Database Configuration
DATABASE_URL=postgresql://user:password@192.168.1.243/googleclock

# API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_CALENDAR_CREDENTIALS=/path/to/google_credentials.json

# Server URLs
AI_SERVER_URL=http://192.168.1.x:8000
FRONTEND_URL=http://192.168.1.x:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# Media Configuration
MEDIA_DIR=/media/clock
THUMBNAIL_DIR=/media/clock/thumbnails
MAX_QUEUE_SIZE=50
AUTO_PLAY_QUEUE=true
ENABLE_TRANSCODING=false

# COLEHUB Integration
COLEHUB_DATABASE_URL=postgresql://user:password@192.168.1.243/colehub

# Voice Assistant
WAKE_WORD_ENABLED=true
VOICE_SENSITIVITY=0.5

# Security (for production)
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=http://localhost:3000,http://192.168.1.x:3000

# Logging
LOG_LEVEL=INFO
