# AI Server Configuration
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8000

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# Whisper Configuration
WHISPER_MODEL=base  # tiny, base, small, medium, large
WHISPER_DEVICE=cuda  # cuda or cpu
WHISPER_LANGUAGE=en

# Wake Word Configuration
WAKE_WORD_ENGINE=porcupine  # porcupine or snowboy
PORCUPINE_ACCESS_KEY=your_porcupine_access_key
WAKE_WORD_SENSITIVITY=0.5

# Face Recognition
FACE_RECOGNITION_TOLERANCE=0.6
FACE_DETECTION_MODEL=hog  # hog or cnn (cnn is more accurate but slower)
MIN_FACE_CONFIDENCE=0.6

# TTS Configuration
TTS_ENGINE=pyttsx3  # pyttsx3 or coqui
TTS_RATE=150  # Words per minute
TTS_VOLUME=0.9

# Model Paths
MODELS_DIR=/app/models
FACE_ENCODINGS_DIR=/app/models/faces

# Logging
LOG_LEVEL=INFO
